# Copie para .env e ajuste se quiser buildar (npm run build) apontando pra um backend
# diferente do padrão. Sem esse arquivo, o build usa o caminho relativo /api/v1 normalmente
# (Docker/nginx e Vercel resolvem isso de outras formas, sem precisar deste arquivo).
API_URL=https://seu-backend.exemplo.com/api/v1
